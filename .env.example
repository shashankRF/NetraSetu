# Optional: enables provider-backed answer synthesis. Keep real keys in .env.
GROQ_API_KEY=

# Use development only for a local demo. Production requires HTTPS and a
# configured administrator account with an Argon2id password hash.
NETRASETU_ENV=development
# NETRASETU_ADMIN_USERNAME=
# NETRASETU_ADMIN_PASSWORD_HASH=
# NETRASETU_ADMIN_PASSWORD=  # development override only; never use in production

# Optional local evidence-classifier selection. Model files must be available.
# NETRASETU_EVIDENCE_MODEL=qwen
# USE_LOCAL_QWEN=1
# NETRASETU_QWEN_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Optional support-report email delivery. Keep credentials in a secret store.
# NETRASETU_SUPPORT_EMAIL=
# NETRASETU_SMTP_HOST=
# NETRASETU_SMTP_FROM=
# NETRASETU_SMTP_PORT=587
# NETRASETU_SMTP_USERNAME=
# NETRASETU_SMTP_PASSWORD=
# NETRASETU_SMTP_TIMEOUT=10
# NETRASETU_SMTP_USE_SSL=false
